{
  "name": "script-net",
  "productName": "ScriptNet",
  "private": true,
  "version": "1.1.0",
  "description": "A tool for visualising crime networks using the Script Network Analysis method.",
  "author": "University of Manchester",
  "license": "GPL-3.0-or-later",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/watch.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "electron-builder --publish never --config .electron-builder.config.js",
    "typecheck": "tsc --noEmit --project packages/renderer/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "package:mac:x64": "electron-builder --mac dmg --x64 --publish never --config .electron-builder.config.js",
    "package:mac:arm64": "electron-builder --mac dmg --arm64 --publish never --config .electron-builder.config.js",
    "package:win:x64": "electron-builder --win nsis --x64 --publish never --config .electron-builder.config.js",
    "postinstall": "node scripts/apply-map-layer-patch.mjs",
    "test:included-key": "node scripts/test-included-key.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@fluentui/react": "^8.64.3",
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.19.5",
    "@types/leaflet": "^1.7.11",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.11",
    "@vitejs/plugin-react": "^5.2.0",
    "axios": "^1.13.6",
    "classnames": "^2.2.6",
    "cytoscape": "^3.16.1",
    "cytoscape-bubblesets": "^3.1.0",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-edgehandles": "^4.0.1",
    "cytoscape-layers": "^2.2.0",
    "cytoscape-leaf": "jthrilly/cytoscape.js-leaflet#b79715dfaf4669874420fb2ee8ba955a47d2e89d",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "formik": "^2.2.9",
    "framer-motion": "^6.2.9",
    "fs-extra": "^9.0.1",
    "html2canvas": "^1.4.1",
    "leaflet": "1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.1",
    "leaflet-geosearch": "^3.6.0",
    "lodash": "^4.18.0",
    "papaparse": "^5.5.3",
    "react": "^17.0.2",
    "react-cytoscapejs": "^1.2.1",
    "react-dom": "^17.0.2",
    "react-hook-form": "^6.8.6",
    "react-leaflet": "^3.2.5",
    "react-leaflet-geosearch": "^0.3.4",
    "react-redux": "^7.1.3",
    "react-storage-hooks": "^4.0.1",
    "redux": "^4.0.5",
    "redux-actions": "^2.6.5",
    "redux-persist": "^6.0.0",
    "sass": "^1.49.7",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1",
    "vite": "7.3.7",
    "yup": "^0.32.11"
  },
  "env": {
    "//": "Used in build scripts",
    "PORT": 3344
  },
  "packageManager": "yarn@1.22.22"
}
